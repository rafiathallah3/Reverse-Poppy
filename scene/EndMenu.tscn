[sub_resource type="GDScript" id="GDScript_j2gu5"]
script/source = "extends Control

@onready var title_label: Label = $UI/CenterContainer/PanelBox/VBoxContainer/TitleLabel
@onready var subtitle_label: Label = $UI/CenterContainer/PanelBox/VBoxContainer/SubtitleLabel
@onready var stats_container: VBoxContainer = $UI/CenterContainer/PanelBox/VBoxContainer/StatsContainer
@onready var total_label: Label = $UI/CenterContainer/PanelBox/VBoxContainer/TotalRow/TotalLabel
@onready var main_menu_button: Button = $UI/CenterContainer/PanelBox/VBoxContainer/MainMenuButton
@onready var transition_overlay: ColorRect = $UI/TransitionOverlay

func _ready() -> void:
	transition_overlay.color = Color(0, 0, 0, 1)
	var fade_in = create_tween()
	fade_in.tween_property(transition_overlay, \"color\", Color(0, 0, 0, 0), 1.0)
	
	_populate_stats()
	_animate_title()
	main_menu_button.pressed.connect(_on_main_menu_pressed)

func _animate_title() -> void:
	title_label.modulate.a = 0.0
	title_label.position.y += 20
	var tween = create_tween()
	tween.tween_property(title_label, \"modulate:a\", 1.0, 0.6).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tween.parallel().tween_property(title_label, \"position:y\", title_label.position.y - 20, 0.6).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	
	# Pulse glow loop
	tween.tween_callback(func():
		var pulse = title_label.create_tween().set_loops()
		pulse.tween_property(title_label, \"modulate\", Color(1.2, 1.2, 1.0, 1.0), 1.2).set_trans(Tween.TRANS_SINE)
		pulse.tween_property(title_label, \"modulate\", Color(1.0, 1.0, 1.0, 1.0), 1.2).set_trans(Tween.TRANS_SINE)
	)

func _populate_stats() -> void:
	var st = get_node_or_null(\"/root/SceneTransition\")
	
	# Clear existing stat rows
	for child in stats_container.get_children():
		child.queue_free()
	
	if not st or st.level_times.is_empty():
		var empty_label = Label.new()
		empty_label.text = \"No level data found.\"
		empty_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		empty_label.add_theme_font_override(\"font\", load(\"res://assets/font/upheavtt.ttf\"))
		empty_label.add_theme_font_size_override(\"font_size\", 18)
		empty_label.add_theme_color_override(\"font_color\", Color(0.6, 0.6, 0.6, 1))
		stats_container.add_child(empty_label)
		total_label.text = \"TOTAL :   --:--:--\"
		return

	# Sort levels numerically
	var level_names = st.level_times.keys()
	level_names.sort_custom(func(a, b):
		var reg = RegEx.new()
		reg.compile(\"\\\\d+\")
		var ra = reg.search(a)
		var rb = reg.search(b)
		var num_a = int(ra.get_string()) if ra else 0
		var num_b = int(rb.get_string()) if rb else 0
		return num_a < num_b
	)

	# Build one row per level with staggered fade-in
	var delay = 0.3
	for level_name in level_names:
		var time_val = st.level_times[level_name]
		var row = _make_stat_row(level_name, st.format_time(time_val))
		stats_container.add_child(row)
		# Stagger fade in
		row.modulate.a = 0.0
		var t = create_tween()
		t.tween_interval(delay)
		t.tween_property(row, \"modulate:a\", 1.0, 0.4)
		delay += 0.15

	# Total time
	total_label.text = \"TOTAL :   \" + st.format_time(st.get_total_time())
	total_label.modulate.a = 0.0
	var total_tween = create_tween()
	total_tween.tween_interval(delay)
	total_tween.tween_property(total_label, \"modulate:a\", 1.0, 0.5)

func _make_stat_row(level_name: String, time_str: String) -> HBoxContainer:
	var row = HBoxContainer.new()
	row.add_theme_constant_override(\"separation\", 0)
	
	var name_label = Label.new()
	name_label.text = level_name.to_upper() + \" :\"
	name_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	name_label.add_theme_font_override(\"font\", load(\"res://assets/font/upheavtt.ttf\"))
	name_label.add_theme_font_size_override(\"font_size\", 20)
	name_label.add_theme_color_override(\"font_color\", Color(0.7, 0.7, 0.7, 1))
	
	var time_label = Label.new()
	time_label.text = time_str
	time_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	time_label.add_theme_font_override(\"font\", load(\"res://assets/font/upheavtt.ttf\"))
	time_label.add_theme_font_size_override(\"font_size\", 20)
	time_label.add_theme_color_override(\"font_color\", Color(0.0, 0.9, 1.0, 1))
	
	row.add_child(name_label)
	row.add_child(time_label)
	return row

func _on_main_menu_pressed() -> void:
	main_menu_button.disabled = true
	var st = get_node_or_null(\"/root/SceneTransition\")
	if st:
		st.level_times.clear()
		st.elapsed_time = 0.0
		st.level_start_time = 0.0
		st.is_finished = false
	var tween = create_tween()
	tween.tween_property(transition_overlay, \"color\", Color(0, 0, 0, 1), 0.8)
	tween.tween_callback(func(): get_tree().change_scene_to_file(\"res://scene/StartMenu.tscn\"))
"

