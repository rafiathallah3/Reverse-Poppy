[gd_scene format=3 uid="uid://5kk1qteuyyv4"]

[sub_resource type="GDScript" id="GDScript_j2gu5"]
script/source = "extends Control

@onready var color_rect: ColorRect = $ColorRect
@onready var vbox: VBoxContainer = $VBoxContainer
@onready var title_label: Label = $VBoxContainer/TitleLabel
@onready var stats_label: Label = $VBoxContainer/StatsLabel
@onready var main_menu_button: Button = $VBoxContainer/MainMenuButton

func _ready() -> void:
	_setup_visuals()
	_populate_stats()
	main_menu_button.pressed.connect(_on_main_menu_pressed)

func _setup_visuals() -> void:
	# Full-screen dark background
	color_rect.color = Color(0.08, 0.08, 0.12, 1.0)
	color_rect.set_anchors_preset(Control.PRESET_FULL_RECT)

	# Center the VBoxContainer on screen
	vbox.set_anchors_preset(Control.PRESET_CENTER)
	vbox.grow_horizontal = Control.GROW_DIRECTION_BOTH
	vbox.grow_vertical = Control.GROW_DIRECTION_BOTH
	vbox.add_theme_constant_override(\"separation\", 18)

	# Title label
	title_label.text = \"CONGRATULATIONS!!\"
	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_label.add_theme_font_size_override(\"font_size\", 42)
	title_label.add_theme_color_override(\"font_color\", Color(0.0, 0.9, 1.0))
	title_label.add_theme_constant_override(\"outline_size\", 6)
	title_label.add_theme_color_override(\"font_outline_color\", Color(0.0, 0.2, 0.4, 0.9))

	# Stats label
	stats_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	stats_label.add_theme_font_size_override(\"font_size\", 22)
	stats_label.add_theme_color_override(\"font_color\", Color(0.85, 0.85, 0.85, 1.0))

	# Main menu button
	main_menu_button.text = \"Return to Main Menu\"
	main_menu_button.add_theme_font_size_override(\"font_size\", 20)
	var btn_style = StyleBoxFlat.new()
	btn_style.bg_color = Color(0.06, 0.06, 0.1, 0.85)
	btn_style.border_width_left = 2
	btn_style.border_width_top = 2
	btn_style.border_width_right = 2
	btn_style.border_width_bottom = 2
	btn_style.border_color = Color(0.0, 0.8, 1.0, 0.6)
	btn_style.set_corner_radius_all(8)
	btn_style.content_margin_left = 24
	btn_style.content_margin_right = 24
	btn_style.content_margin_top = 10
	btn_style.content_margin_bottom = 10
	main_menu_button.add_theme_stylebox_override(\"normal\", btn_style)
	main_menu_button.add_theme_color_override(\"font_color\", Color(0.0, 0.9, 1.0))

	# Fade-in animation
	modulate.a = 0.0
	var tween = create_tween()
	tween.tween_property(self, \"modulate:a\", 1.0, 0.8).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)

func _populate_stats() -> void:
	var st = get_node_or_null(\"/root/SceneTransition\")
	if not st:
		stats_label.text = \"Error: SceneTransition not found!\"
		return

	if st.level_times.is_empty():
		stats_label.text = \"No level data found.\"
		return

	# Sort level keys numerically (Level 1, Level 2, Level 3 — not Level 1, Level 10, Level 2)
	var level_names = st.level_times.keys()
	level_names.sort_custom(func(a, b):
		var reg = RegEx.new()
		reg.compile(\"\\\\d+\")
		var ra = reg.search(a)
		var rb = reg.search(b)
		var num_a = int(ra.get_string()) if ra else 0
		var num_b = int(rb.get_string()) if rb else 0
		return num_a < num_b
	)

	var stats_text = \"LEVEL COMPLETION TIMES:\\n\\n\"
	for level_name in level_names:
		var time_val = st.level_times[level_name]
		stats_text += level_name + \" :   \" + st.format_time(time_val) + \"\\n\"

	stats_text += \"\\n---------------------\\n\"
	stats_text += \"Total :   \" + st.format_time(st.get_total_time())

	stats_label.text = stats_text

func _on_main_menu_pressed() -> void:
	var st = get_node_or_null(\"/root/SceneTransition\")
	if st:
		st.level_times.clear()
		st.elapsed_time = 0.0
		st.level_start_time = 0.0
		st.is_finished = false
	get_tree().change_scene_to_file(\"res://scene/StartMenu.tscn\")
"

